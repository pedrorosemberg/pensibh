---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.tsx';
import PlanExplorer from '../components/PlanExplorer.tsx';
import CountUp from '../components/CountUp.tsx';
import WhatsAppIcon from '../components/WhatsAppIcon.tsx';
import Footer from '../components/Footer.astro';
import {
  Award,
  BookOpen,
  Clock,
  ExternalLink,
  GraduationCap,
  MapPin,
  Phone,
  Quote,
  Star,
  UserCheck,
  Users,
  Target,
} from 'lucide-react';
import {
  SITE,
  NAV,
  BRUNO,
  COURSES,
  DIFERENCIAIS,
  STEPS,
  SLOTS,
  TESTIMONIALS,
  GOOGLE_REVIEWS,
  VIDEO_TESTIMONIALS,
  REVIEWS_LINK,
  FAQ,
  MAPS_LINK,
  MAPS_EMBED,
  whatsapp,
} from '../data/site';
import logo from '../assets/logo-pensi.png';
import heroImg from '../assets/bruno-quadro.jpeg';
import salaImg from '../assets/sala.jpeg';
import brunoImg from '../assets/bruno.jpeg';

const logoSmall = await getImage({ src: logo, width: 172, format: 'webp' });
const waGeral = whatsapp('Olá, Bruno! Vim pelo site e quero saber mais sobre as aulas da PENSI+.');
const icons = { users: Users, 'user-check': UserCheck, 'book-open': BookOpen, clock: Clock, award: Award, 'map-pin': MapPin };
const courseIcons = { cefet: Target, enem: GraduationCap, cesec: BookOpen } as const;
const subjects = ['Matemática', 'Física', 'Química', 'Biologia', 'Português', 'Redação', 'História', 'Geografia', 'Inglês', 'Filosofia', 'Sociologia', 'Literatura'];
const year = new Date().getFullYear();
---

<Base>
  <Header client:load logoSrc={logoSmall.src} whatsappHref={waGeral} />

  <main id="conteudo">
    {/* HERO */}
    <section id="topo" class="relative isolate overflow-hidden bg-pensi pb-20 pt-24 text-white sm:pb-28 sm:pt-36 lg:pb-36">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute -right-24 top-10 h-[130%] w-[60%] -skew-y-6 bg-pensi-700/60"></div>
        <div class="absolute bottom-0 left-0 h-24 w-full bg-papel slant-bottom"></div>
      </div>

      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:gap-12 sm:px-5 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="hero-in">
          <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-[13px] font-medium ring-1 ring-white/25 sm:px-4 sm:text-sm">
            <span class="size-2 rounded-full bg-oliva" aria-hidden="true"></span>
            Matrículas abertas para 2027 · 8 vagas por turma
          </p>
          <h1 class="mt-5 text-balance text-[2.35rem] font-black leading-[1.04] tracking-tight sm:mt-6 sm:text-5xl lg:text-6xl">
            Estude com o professor Bruno, <span class="text-oliva">um aluno de cada vez.</span>
          </h1>
          <p class="mt-5 max-w-xl text-pretty text-[17px] leading-relaxed text-white/85 sm:mt-6 sm:text-xl">
            Pré-vestibular para ENEM, CESEC, ENCCEJA e CEFET em turmas reduzidas de até 8 alunos: cada aluno é uma aula
            particular. Mais de {BRUNO.years} anos preparando jovens e adultos em Belo Horizonte.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:mt-9 sm:flex-row sm:flex-wrap">
            <a
              href={waGeral}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex min-h-14 whitespace-nowrap items-center justify-center gap-2 rounded-full bg-oliva px-6 text-base font-bold text-tinta shadow-lg shadow-pensi-900/30 transition hover:-translate-y-0.5 hover:bg-oliva-200"
            >
              <WhatsAppIcon className="size-5" />
              Falar com o Bruno no WhatsApp
            </a>
            <a
              href="#agenda"
              class="inline-flex min-h-14 items-center justify-center whitespace-nowrap rounded-full px-6 text-base font-semibold text-white ring-1 ring-white/40 transition hover:bg-white/10"
            >
              Horários e valores
            </a>
          </div>
          <ul class="mt-8 grid grid-cols-1 gap-y-3 text-[15px] text-white/90 sm:mt-10 sm:flex sm:flex-wrap sm:gap-x-6">
            <li class="flex items-center gap-2"><Users aria-hidden="true" class="size-5 text-oliva" /> Até 8 alunos por turma</li>
            <li class="flex items-center gap-2"><UserCheck aria-hidden="true" class="size-5 text-oliva" /> Atendimento individual</li>
            <li class="flex items-center gap-2"><MapPin aria-hidden="true" class="size-5 text-oliva" /> Anchieta, BH</li>
          </ul>
        </div>

        <div class="hero-in-late relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="slant overflow-hidden rounded-3xl bg-pensi-900 shadow-2xl shadow-pensi-900/40">
            <Image
              src={heroImg}
              alt="Professor Bruno explicando um exercício de geometria no quadro para uma aluna"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 520px, 90vw"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/3.4] w-full object-cover object-[70%_center] sm:aspect-[4/4.4]"
            />
          </div>
          <div class="absolute -bottom-6 left-3 rounded-2xl bg-white px-4 py-3 text-tinta shadow-xl sm:-left-8 sm:px-5 sm:py-4">
            <p class="text-3xl font-black text-pensi"><CountUp client:visible value={30} suffix="+" /></p>
            <p class="text-sm font-medium text-tinta-600">anos de aulas particulares</p>
          </div>
          <div class="absolute right-3 top-5 rounded-2xl bg-agua px-3.5 py-2.5 text-[15px] font-semibold text-tinta shadow-xl sm:-right-6 sm:top-8 sm:px-4 sm:py-3 sm:text-base">
            1 professor · você no centro
          </div>
        </div>
      </div>
    </section>

    {/* FAIXA DE MATÉRIAS */}
    <div class="overflow-hidden border-y border-tinta/10 bg-white py-4" aria-label="Matérias ofertadas">
      <ul class="marquee flex w-max gap-8 pr-8 text-base font-semibold text-tinta-600 sm:gap-10 sm:pr-10 sm:text-lg">
        {[...subjects, ...subjects].map((s, i) => (
          <li class="flex items-center gap-10" aria-hidden={i >= subjects.length ? 'true' : undefined}>
            {s}<span class="text-oliva" aria-hidden="true">+</span>
          </li>
        ))}
      </ul>
    </div>

    {/* CURSOS */}
    <section id="cursos" class="mx-auto max-w-6xl px-4 py-16 sm:px-5 sm:py-24" aria-labelledby="cursos-titulo">
      <div class="max-w-2xl" data-reveal>
        <p class="font-semibold uppercase tracking-wide text-pensi">Cursos</p>
        <h2 id="cursos-titulo" class="mt-2 text-balance text-3xl font-black tracking-tight sm:text-4xl">
          Uma preparação para cada objetivo, do 9º ano à volta aos estudos
        </h2>
        <p class="mt-4 text-lg text-tinta-600">
          Jovens que miram o CEFET ou o ENEM e adultos que querem concluir os estudos estudam lado a lado, cada um com o
          seu plano.
        </p>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          COURSES.map((c, i) => {
            const Icon = courseIcons[c.id];
            return (
              <li
                data-reveal
                data-reveal-delay={i * 80}
                class="group relative overflow-hidden rounded-3xl bg-white p-6 ring-1 sm:p-7 ring-tinta/10 transition hover:-translate-y-1 hover:shadow-[0_24px_60px_-30px_rgba(190,31,61,0.5)]"
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="inline-flex size-14 items-center justify-center rounded-2xl bg-pensi text-white transition group-hover:rotate-[-6deg]">
                    <Icon aria-hidden="true" class="size-7" />
                  </span>
                  <span class="rounded-full bg-agua-50 px-3 py-1 text-sm font-semibold text-agua-700">{c.audience}</span>
                </div>
                <h3 class="mt-6 text-2xl font-bold tracking-tight">{c.title}</h3>
                <p class="mt-2 text-tinta-600">{c.summary}</p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {c.tags.map((t) => (
                    <li class="rounded-full bg-papel px-3 py-1 text-sm text-tinta-600 ring-1 ring-tinta/10">{t}</li>
                  ))}
                </ul>
                <a
                  href={whatsapp(`Olá, Bruno! Quero saber mais sobre o curso ${c.title}.`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-pensi hover:underline"
                >
                  Tirar dúvidas sobre este curso <span aria-hidden="true">→</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </section>

    {/* O PROFESSOR */}
    <section id="bruno" class="bg-tinta py-16 text-white sm:py-24" aria-labelledby="bruno-titulo">
      <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-5 lg:grid-cols-2">
        <div class="relative" data-reveal>
          <div class="slant-soft overflow-hidden rounded-3xl">
            <Image
              src={salaImg}
              alt="Professor Bruno acompanhando uma aluna enquanto a turma resolve exercícios na sala da PENSI+"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 560px, 92vw"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
          <div class="absolute -bottom-8 right-4 flex items-center gap-3 rounded-2xl bg-white p-3 pr-5 text-tinta shadow-2xl sm:right-8">
            <Image src={brunoImg} alt="" width={64} height={64} class="size-14 rounded-xl object-cover object-[85%_30%]" />
            <div>
              <p class="font-bold">Professor Bruno</p>
              <p class="text-sm text-tinta-600">Fundador da PENSI+</p>
            </div>
          </div>
        </div>
        <div data-reveal>
          <p class="font-semibold uppercase tracking-wide text-oliva">O professor</p>
          <h2 id="bruno-titulo" class="mt-2 text-balance text-3xl font-black tracking-tight sm:text-4xl">
            Três décadas ensinando um aluno de cada vez
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-white/80">
            O professor Bruno ainda cursava Engenharia Civil na UFMG quando começou a dar aulas. Ele desenvolveu um método
            próprio que os alunos abraçaram.
          </p>
          <p class="mt-4 text-lg leading-relaxed text-white/80">
            Já são mais de 30 anos de experiência e, nesse tempo, ajudou centenas de alunos a conquistarem seus objetivos.
          </p>
          <ul class="mt-8 space-y-3">
            {
              BRUNO.facts.map((f) => (
                <li class="flex gap-3">
                  <span class="mt-1 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-oliva text-sm font-black text-tinta" aria-hidden="true">+</span>
                  <span class="text-white/90">{f}</span>
                </li>
              ))
            }
          </ul>
          <a
            href={whatsapp('Olá, Bruno! Gostaria de conversar sobre as aulas.')}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-9 inline-flex min-h-12 items-center gap-2 rounded-full bg-oliva px-6 font-bold text-tinta transition hover:bg-oliva-200"
          >
            <WhatsAppIcon className="size-5" />
            Converse com o Bruno
          </a>
        </div>
      </div>
    </section>

    {/* DIFERENCIAIS */}
    <section id="diferenciais" class="mx-auto max-w-6xl px-4 pb-8 pt-24 sm:px-5 sm:pb-12 sm:pt-32" aria-labelledby="dif-titulo">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="font-semibold uppercase tracking-wide text-pensi">Nossos diferenciais</p>
        <h2 id="dif-titulo" class="mt-2 text-balance text-3xl font-black tracking-tight sm:text-4xl">
          A atenção de uma aula particular, no ritmo de um curso completo
        </h2>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          DIFERENCIAIS.map((d, i) => {
            const Icon = icons[d.icon];
            return (
              <li data-reveal data-reveal-delay={i * 60} class="rounded-3xl bg-white p-7 ring-1 ring-tinta/10">
                <Icon aria-hidden="true" class="size-8 text-pensi" />
                <h3 class="mt-5 text-xl font-bold">{d.title}</h3>
                <p class="mt-2 text-tinta-600">{d.text}</p>
              </li>
            );
          })
        }
      </ul>

      {/* COMO FUNCIONA */}
      <div class="mt-14 rounded-[2rem] bg-pensi-50 p-6 sm:mt-20 sm:p-12" data-reveal>
        <h2 class="text-2xl font-black tracking-tight sm:text-3xl">Como começar</h2>
        <ol class="mt-8 grid gap-8 md:grid-cols-3">
          {
            STEPS.map((s, i) => (
              <li class="relative">
                <span class="text-5xl font-black text-pensi/25" aria-hidden="true">0{i + 1}</span>
                <h3 class="mt-2 text-xl font-bold">{s.title}</h3>
                <p class="mt-2 text-tinta-600">{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* HORÁRIOS E VALORES */}
    <section id="agenda" class="mx-auto max-w-6xl px-4 py-14 sm:px-5 sm:py-20" aria-labelledby="agenda-titulo">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="font-semibold uppercase tracking-wide text-pensi">Horários e valores 2027</p>
        <h2 id="agenda-titulo" class="mt-2 text-balance text-3xl font-black tracking-tight sm:text-4xl">
          Escolha o curso e o horário da sua turma
        </h2>
        <p class="mt-4 text-lg text-tinta-600">
          Cinco aulas por semana, de segunda a sexta, na unidade do Anchieta. Todas as disciplinas são ofertadas, e você
          escolhe quais quer estudar.
        </p>
      </div>
      <div class="mt-10" data-reveal>
        <PlanExplorer client:visible />
      </div>

      <div class="mt-12 sm:hidden" data-reveal>
        <h3 class="text-lg font-bold">Agenda da semana</h3>
        <ul class="mt-4 space-y-3">
          {
            SLOTS.map((s) => (
              <li class="rounded-2xl bg-white p-5 ring-1 ring-tinta/10">
                <p class="text-xl font-bold text-pensi">{s.label}</p>
                <p class="mt-1 text-tinta-600">{s.duration} · segunda a sexta</p>
                <p class="mt-1 text-tinta-600">CEFET (1º e 2º semestre) e ENEM anual</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-16 hidden overflow-x-auto rounded-3xl bg-white ring-1 ring-tinta/10 sm:block" data-reveal>
        <table class="w-full min-w-[640px] text-left">
          <caption class="px-6 pt-6 text-left text-lg font-bold">Agenda da semana</caption>
          <thead>
            <tr class="text-sm uppercase tracking-wide text-tinta-600">
              <th scope="col" class="px-6 py-4 font-semibold">Horário</th>
              <th scope="col" class="px-6 py-4 font-semibold">Duração</th>
              <th scope="col" class="px-6 py-4 font-semibold">Dias</th>
              <th scope="col" class="px-6 py-4 font-semibold">Cursos</th>
            </tr>
          </thead>
          <tbody>
            {
              SLOTS.map((s) => (
                <tr class="border-t border-tinta/10">
                  <th scope="row" class="px-6 py-4 font-bold text-pensi">{s.label}</th>
                  <td class="px-6 py-4">{s.duration}</td>
                  <td class="px-6 py-4">Segunda a sexta</td>
                  <td class="px-6 py-4">CEFET (1º e 2º semestre) e ENEM anual</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {/* DEPOIMENTOS */}
    <section id="depoimentos" class="bg-white py-16 sm:py-24" aria-labelledby="dep-titulo">
      <div class="mx-auto max-w-6xl px-4 sm:px-5">
        <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end" data-reveal>
          <div class="max-w-2xl">
            <p class="font-semibold uppercase tracking-wide text-pensi">Depoimentos</p>
            <h2 id="dep-titulo" class="mt-2 text-balance text-3xl font-black tracking-tight sm:text-4xl">
              Alunos e famílias contam como foi estudar com o Bruno
            </h2>
          </div>
          <a
            href={REVIEWS_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 rounded-2xl bg-papel px-5 py-4 ring-1 ring-tinta/10 transition hover:ring-pensi/40"
          >
            <span class="text-4xl font-black text-tinta">{GOOGLE_REVIEWS.rating.toFixed(1).replace('.', ',')}</span>
            <span>
              <span class="flex gap-0.5 text-[#e8a400]" aria-hidden="true">
                {[1, 2, 3, 4, 5].map(() => <Star class="size-5" fill="currentColor" />)}
              </span>
              <span class="mt-1 block text-sm text-tinta-600">
                <span class="sr-only">Nota {GOOGLE_REVIEWS.rating.toFixed(1).replace('.', ',')} de 5, </span>{GOOGLE_REVIEWS.count} avaliações no Google
              </span>
            </span>
          </a>
        </div>

        <h3 class="mt-10 text-xl font-bold sm:mt-12">Depoimentos em vídeo</h3>
        <ul class="-mx-4 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-6 sm:overflow-visible sm:px-0 lg:mx-auto lg:max-w-4xl" tabindex="0" aria-label="Depoimentos em vídeo: deslize para ver mais">
          {
            VIDEO_TESTIMONIALS.map((v) => (
              <li class="w-[72%] max-w-[320px] shrink-0 snap-center sm:w-auto sm:max-w-none">
                <video
                  class="aspect-[9/16] w-full rounded-3xl bg-tinta object-cover shadow-lg ring-1 ring-tinta/10"
                  controls
                  playsinline
                  preload="none"
                  poster={v.poster}
                  width={v.width}
                  height={v.height}
                  aria-label={v.label}
                >
                  <source src={v.src} type="video/mp4" />
                </video>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-10 text-xl font-bold sm:mt-14">O que dizem no Google</h3>
        <ul class="-mx-4 mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:mx-0 sm:block sm:gap-5 sm:overflow-visible sm:px-0 sm:pb-0 sm:columns-2 lg:columns-3" tabindex="0" aria-label="Depoimentos: deslize para ver mais">
          {
            TESTIMONIALS.map((t, i) => (
              <li data-reveal data-reveal-delay={(i % 3) * 80} class="w-[86%] shrink-0 snap-center rounded-3xl bg-papel p-6 ring-1 ring-tinta/10 sm:mb-5 sm:w-auto sm:break-inside-avoid sm:p-7">
                <figure>
                  <div class="flex items-center justify-between">
                    <Quote aria-hidden="true" class="size-7 text-pensi" />
                    <span class="flex gap-0.5 text-[#e8a400]" aria-label="5 estrelas">
                      {[1, 2, 3, 4, 5].map(() => <Star aria-hidden="true" class="size-4" fill="currentColor" />)}
                    </span>
                  </div>
                  <blockquote class="mt-4 text-[17px] leading-relaxed"><strong class="text-pensi">{t.name}:</strong> {t.text}</blockquote>
                  <figcaption class="mt-5 flex items-center gap-3">
                    <span class="inline-flex size-10 items-center justify-center rounded-full bg-pensi text-sm font-bold text-white" aria-hidden="true">
                      {t.name.charAt(0)}
                    </span>
                    <span>
                      <span class="block font-bold">{t.name}</span>
                      {t.context && <span class="block text-sm text-tinta-600">{t.context}</span>}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        <p class="mt-2 text-center text-sm text-tinta-600 sm:hidden" aria-hidden="true">Deslize para ver mais depoimentos →</p>
        <p class="mt-6 text-center" data-reveal>
          <a
            href={REVIEWS_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center gap-2 rounded-full bg-pensi px-6 font-semibold text-white transition hover:bg-pensi-700"
          >
            Ler todas as avaliações no Google
            <ExternalLink aria-hidden="true" class="size-4" />
          </a>
        </p>
        <p class="mt-3 text-center text-sm text-tinta-600">Avaliações publicadas no perfil “Bruno Professor BH” no Google Maps, com o nome como aparece no Google.</p>
      </div>
    </section>

    {/* PERGUNTAS FREQUENTES */}
    <section id="perguntas" class="mx-auto max-w-3xl px-4 py-16 sm:px-5 sm:py-24" aria-labelledby="faq-titulo">
      <h2 id="faq-titulo" class="text-center text-3xl font-black tracking-tight sm:text-4xl" data-reveal>
        Perguntas frequentes
      </h2>
      <div class="mt-10 space-y-3">
        {
          FAQ.map((f) => (
            <details data-reveal class="group rounded-2xl bg-white ring-1 ring-tinta/10 open:ring-pensi/40">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-2xl text-pensi transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="px-6 pb-6 text-tinta-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    {/* CONTATO E ENDEREÇO */}
    <section id="contato" class="relative bg-pensi py-16 text-white sm:py-24" aria-labelledby="contato-titulo">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-5 lg:grid-cols-2">
        <div data-reveal>
          <p class="font-semibold uppercase tracking-wide text-oliva">Contato e endereço</p>
          <h2 id="contato-titulo" class="mt-2 text-balance text-3xl font-black tracking-tight sm:text-4xl">
            Vamos montar o seu plano de estudos?
          </h2>
          <p class="mt-4 text-lg text-white/85">
            Alunos e pais podem falar direto com o professor Bruno para tirar dúvidas, conhecer as turmas e reservar uma
            vaga.
          </p>
          <address class="mt-8 space-y-4 not-italic">
            <p class="flex gap-3">
              <MapPin aria-hidden="true" class="mt-0.5 size-6 shrink-0 text-oliva" />
              <span>
                {SITE.address.street}<br />
                {SITE.address.neighborhood}, {SITE.address.city} – {SITE.address.region}, {SITE.address.postalCode}
              </span>
            </p>
            <p class="flex gap-3">
              <Phone aria-hidden="true" class="mt-0.5 size-6 shrink-0 text-oliva" />
              <a href={`tel:${SITE.phoneE164}`} class="-my-2 inline-flex min-h-11 items-center underline-offset-4 hover:underline">{SITE.phoneDisplay}</a>
            </p>
            <p class="flex gap-3">
              <Clock aria-hidden="true" class="mt-0.5 size-6 shrink-0 text-oliva" />
              <span>Aulas de segunda a sexta, das 8:10 às 12:20 e das 14:30 às 16:20</span>
            </p>
          </address>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a
              href={waGeral}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full bg-oliva px-7 text-lg font-bold text-tinta transition hover:bg-oliva-200"
            >
              <WhatsAppIcon className="size-5" />
              Chamar no WhatsApp
            </a>
            <a
              href={MAPS_LINK}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-14 items-center justify-center gap-2 rounded-full px-7 text-lg font-semibold ring-1 ring-white/40 transition hover:bg-white/10"
            >
              Como chegar
              <ExternalLink aria-hidden="true" class="size-4" />
            </a>
          </div>
        </div>

        <div data-reveal class="overflow-hidden rounded-3xl bg-pensi-900 ring-1 ring-white/15">
          <div id="mapa" data-src={MAPS_EMBED} class="relative flex aspect-[4/3] w-full items-center justify-center">
            <button
              type="button"
              id="mapa-carregar"
              class="m-6 inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 font-semibold text-tinta transition hover:bg-oliva"
            >
              <MapPin aria-hidden="true" class="size-5 text-pensi" />
              Mostrar mapa do Google
            </button>
            <p class="absolute bottom-4 px-6 text-center text-sm text-white/70">
              O mapa só carrega se você pedir, para proteger sua privacidade.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />


</Base>

<style>
  .slant-bottom {
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .hero-in {
    animation: rise 900ms var(--ease-out-soft) both;
  }
  .hero-in-late {
    animation: rise 900ms 180ms var(--ease-out-soft) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }
</style>

<script>
  // Mapa sob demanda: nenhum recurso do Google é carregado antes do clique.
  const box = document.getElementById('mapa');
  const btn = document.getElementById('mapa-carregar');
  btn?.addEventListener('click', () => {
    const src = box?.dataset.src;
    if (!box || !src || !src.startsWith('https://www.google.com/maps')) return;
    const frame = document.createElement('iframe');
    frame.src = src;
    frame.title = 'Mapa da PENSI+ no Anchieta, Belo Horizonte';
    frame.loading = 'lazy';
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.className = 'absolute inset-0 h-full w-full border-0';
    frame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox');
    box.replaceChildren(frame);
    frame.focus();
  });
</script>
