---
import '../styles/global.css';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import { SITE, FAQ, PLANS, COURSES, BRUNO } from '../data/site';
import ogImage from '../assets/og-v2.png';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  /** Caminho no site, ex.: 'privacidade/'. Vazio = página inicial. */
  path?: string;
}
const { title = SITE.title, description = SITE.description, path = '' } = Astro.props;
const isHome = path === '';
const canonical = SITE.url;
const pageUrl = new URL(path, canonical).href;
const og = new URL(ogImage.src, Astro.site).toString();

const website = {
  '@type': 'WebSite',
  '@id': `${canonical}#website`,
  url: canonical,
  name: SITE.name,
  inLanguage: 'pt-BR',
  publisher: { '@id': `${canonical}#pensi` },
};

const org = {
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${canonical}#pensi`,
  name: SITE.name,
  alternateName: ['PENSI', 'PENSI+ Educação'],
  url: canonical,
  logo: new URL('/images/logo-pensi.png', Astro.site).toString(),
  image: og,
  telephone: SITE.phoneE164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  areaServed: { '@type': 'City', name: 'Belo Horizonte' },
  sameAs: [SITE.instagram, SITE.facebook],
  founder: { '@id': `${canonical}#bruno` },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SITE.phoneE164,
    contactType: 'admissions',
    availableLanguage: 'Portuguese',
  },
};

const person = {
  '@type': 'Person',
  '@id': `${canonical}#bruno`,
  name: 'Bruno Kleist Visacro Montoni',
  alternateName: ['Professor Bruno', 'Bruno Professor BH'],
  jobTitle: BRUNO.role,
  description: BRUNO.facts.join('. ') + '.',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Federal de Minas Gerais (UFMG)' },
  worksFor: { '@id': `${canonical}#pensi` },
};

const courses = PLANS.map((p) => ({
  '@type': 'Course',
  name: `Curso presencial ${p.name}`,
  description: `Turmas de até 8 alunos com atendimento individual. ${p.period}. ${p.note}.`,
  provider: { '@id': `${canonical}#pensi` },
  inLanguage: 'pt-BR',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'BRL',
    lowPrice: Math.min(...Object.values(p.prices).map((x) => x.to)),
    highPrice: Math.max(...Object.values(p.prices).map((x) => x.to)),
    offerCount: Object.keys(p.prices).length,
    availability: 'https://schema.org/LimitedAvailability',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    location: { '@id': `${canonical}#pensi` },
  },
}));

const otherCourses = COURSES.filter((c) => c.id === 'cesec').map((c) => ({
  '@type': 'Course',
  name: c.title,
  description: c.summary,
  provider: { '@id': `${canonical}#pensi` },
  inLanguage: 'pt-BR',
}));

const faq = {
  '@type': 'FAQPage',
  '@id': `${canonical}#perguntas`,
  isPartOf: { '@id': canonical },
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const page = {
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: title,
  description,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': website['@id'] },
  publisher: { '@id': org['@id'] },
  ...(isHome ? { about: { '@id': person['@id'] }, hasPart: { '@id': faq['@id'] } } : { breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: canonical },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
    ],
  } }),
};

const graph = isHome
  ? [website, org, person, page, faq, ...courses, ...otherCourses]
  : [page];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <GoogleTagManager />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#be1f3d" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/png" href="/images/pensi-flaticon.png" />
    <link rel="apple-touch-icon" href="/images/pensi-sem-fundo-2.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="PENSI+" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Professor Bruno explicando matemática no quadro para uma aluna, com a logo da PENSI+" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <meta name="geo.region" content="BR-MG" />
    <meta name="geo.placename" content="Belo Horizonte" />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-tinta focus:px-4 focus:py-3 focus:text-white"
      >Pular para o conteúdo</a
    >
    <slot />
    <ConsentBanner privacyHref={`${SITE.url}privacidade/`} />
  </body>
</html>
