---
import { getImage } from 'astro:assets';
import Base from './Base.astro';
import Header from '../components/Header.tsx';
import Footer from '../components/Footer.astro';
import { whatsapp } from '../data/site';
import logo from '../assets/logo-pensi.png';

interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
const logoSmall = await getImage({ src: logo, width: 172, format: 'webp' });
const wa = whatsapp('Olá! Tenho uma dúvida sobre os documentos do site da PENSI+.');
---

<Base title={`${title} | PENSI+`} description={description} path={path}>
  <Header client:load logoSrc={logoSmall.src} whatsappHref={wa} hrefPrefix="/v2/" />
  <main id="conteudo" class="bg-papel pb-24 pt-32">
    <article class="legal mx-auto max-w-3xl px-5">
      <p class="font-semibold uppercase tracking-wide text-pensi">PENSI+</p>
      <h1>{title}</h1>
      <p class="text-tinta-600">Última atualização: {updated}</p>
      <slot />
    </article>
  </main>
  <Footer />
</Base>
